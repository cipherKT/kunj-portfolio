    { "id": "1", "type": "text", "x": 0, "y": 0, "width": 250, "height": 120, "text": "## Recon\n\nFound an exposed admin panel via directory brute force." },
    { "id": "2", "type": "text", "x": 350, "y": 0, "width": 250, "height": 120, "text": "## Injection point\n\nLogin form's `username` field wasn't parameterized." },
